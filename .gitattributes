# 统一在仓库内以 LF 存储，避免 Windows 上提交 CRLF 后
# 在 Linux 侧出现 /bin/sh: $'\r': command not found
* text=auto

*.sh            text eol=lf
Jenkinsfile     text eol=lf
Dockerfile      text eol=lf
*.py            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.html          text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.conf          text eol=lf
LICENSE         text eol=lf