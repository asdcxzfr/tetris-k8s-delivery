#!/bin/bash
# ==============================================================================
#  故障自愈计时  (read-only + 一次破坏性动作, 但可自动恢复)
#
#  用法:  /root/selfheal-test.sh pod     # 场景A: 删除 Pod (ReplicaSet 重建)
#         /root/selfheal-test.sh proc    # 场景B: 杀掉容器内 PID 1 (kubelet 重启容器)
#
#  场景A 预期: 3~8 秒      (调度 + 拉镜像缓存 + 启动 + 首次探针通过)
#  场景B 预期: 12~18 秒    (kubelet 首次重启退避就是 10s, 再加启动 + 探针)
# ==============================================================================
set -u
NS=tetris-test
LABEL='app=tetris-game'
MODE="${1:-pod}"

pick() { kubectl -n $NS get pod -l $LABEL -o jsonpath='{.items[0].metadata.name}' 2>/dev/null; }
ready() { kubectl -n $NS get pod "$1" -o jsonpath='{.status.containerStatuses[0].ready}' 2>/dev/null; }
rc_of() { kubectl -n $NS get pod "$1" -o jsonpath='{.status.containerStatuses[0].restartCount}' 2>/dev/null; }

if [ "$MODE" = "pod" ]; then
  OLD=$(pick)
  [ -z "$OLD" ] && { echo "找不到 Pod"; exit 1; }
  echo "旧 Pod : $OLD  (IP $(kubectl -n $NS get pod "$OLD" -o jsonpath='{.status.podIP}'))"
  echo "操作   : kubectl delete pod $OLD"
  T0=$(date +%s%3N)
  kubectl -n $NS delete pod "$OLD" --wait=false >/dev/null 2>&1
  while :; do
    NAME=$(pick)
    if [ -n "$NAME" ] && [ "$NAME" != "$OLD" ] && [ "$(ready "$NAME")" = "true" ]; then break; fi
    sleep 0.3
  done
  T1=$(date +%s%3N)
  echo "新 Pod : $NAME  (IP $(kubectl -n $NS get pod "$NAME" -o jsonpath='{.status.podIP}'))"
  echo "----------------------------------------------------"
  echo "恢复耗时: $(( T1 - T0 )) ms   ( $(( (T1-T0)/1000 )) 秒 )"
  if [ $(( T1 - T0 )) -le 10000 ]; then echo "判定: ✅ 10 秒内恢复"; else echo "判定: ❌ 超过 10 秒"; fi
  exit 0
fi

if [ "$MODE" = "proc" ]; then
  POD=$(pick)
  [ -z "$POD" ] && { echo "找不到 Pod"; exit 1; }
  RC0=$(rc_of "$POD")
  echo "Pod    : $POD   当前 restartCount = $RC0"
  echo "操作   : kubectl exec $POD -- sh -c 'kill -9 1'"
  echo "         (注: 对 PID 1 用 -9, 因为 python 没装 SIGTERM handler, SIGTERM 会被内核忽略)"
  T0=$(date +%s%3N)
  kubectl -n $NS exec "$POD" -- sh -c 'kill -9 1' >/dev/null 2>&1 || true
  while :; do
    RC=$(rc_of "$POD")
    if [ -n "$RC" ] && [ "$RC" -gt "$RC0" ] && [ "$(ready "$POD")" = "true" ]; then break; fi
    sleep 0.3
  done
  T1=$(date +%s%3N)
  echo "restartCount: $RC0 -> $RC"
  echo "----------------------------------------------------"
  echo "恢复耗时: $(( T1 - T0 )) ms   ( $(( (T1-T0)/1000 )) 秒 )"
  echo "参考: kubelet 首次重启退避 = 10s (指数退避 10s/20s/40s..., 上限 5min)"
  if [ $(( T1 - T0 )) -le 10000 ]; then echo "判定: ✅ 10 秒内恢复"; else echo "判定: ⚠️ 超过 10 秒 (符合 kubelet 退避预期)"; fi
  exit 0
fi

echo "用法: $0 {pod|proc}"
exit 1
